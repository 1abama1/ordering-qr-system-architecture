# Install a valid certificate and mount it into Nginx; this is a deployment example.
server {
    listen 80;
    server_name restaurant.example.com;
    return 301 https://$host$request_uri;
}
# In default.conf change listen 80 to listen 443 ssl and add:
# server_name restaurant.example.com;
# ssl_certificate /etc/nginx/certs/fullchain.pem;
# ssl_certificate_key /etc/nginx/certs/privkey.pem;
# ssl_protocols TLSv1.2 TLSv1.3;
# add_header Strict-Transport-Security "max-age=31536000" always;
# Publish 443:443 in a deployment-specific Compose override.
# The existing proxy_set_header X-Forwarded-Proto $scheme then forwards https.
