# Copy to .env and generate independent random values. Never commit .env.
DB_PASSWORD=
JWT_SECRET=
QR_SECRET=
# prod disables Swagger and all demo menu/table seeding. dev enables both.
APP_PROFILE=dev
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
GUEST_MENU_URL=http://localhost:5173/menu
# Initial administrator; supply together. Password: >=12 chars, <=72 UTF-8 bytes.
# Existing accounts are never reset by bootstrap. Remove after provisioning.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
